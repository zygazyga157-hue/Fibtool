# Database
DATABASE_URL=sqlite:///./fibtool.db
# For production: postgresql://user:password@localhost/fibtool

# Security
SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PayNow Configuration
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key
PAYNOW_RETURN_URL=http://localhost:3000/payment-return
PAYNOW_RESULT_URL=http://localhost:8000/api/v1/webhooks/paynow

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@fibtool.com

# Admin Notifications
ADMIN_EMAIL=admin@fibtool.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development
